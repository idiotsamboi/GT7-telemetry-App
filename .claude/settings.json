{
  "permissions": {
    "allow": [
      "Bash(python -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(npm --prefix frontend run:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/node_modules/**)",
      "Read(./frontend/dist/**)",
      "Read(./**/*.sqlite)",
      "Read(./**/*.sqlite3)",
      "Read(./**/*.db)",
      "Read(./**/*.log)",
      "Read(./.pytest_tmp/**)",
      "Read(./scratch/**)",
      "Read(./**/package-lock.json)",
      "Read(./requirements-lock.txt)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/session_state.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guard_hotspots.py"
          }
        ]
      }
    ]
  }
}
